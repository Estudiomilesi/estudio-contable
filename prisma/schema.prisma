// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProfessionalLabel {
  F
  FJ
  JF
}

enum BillingProfile {
  FEDE_RI
  JUANMA_MONO
  NO_FISCAL
}

model Client {
  id                String             @id @default(cuid())
  code              String             @unique
  name              String
  address           String?
  cuit              String?
  email             String
  cellphone         String?
  contact           String?
  fiscalCondition   String?
  professionalLabel ProfessionalLabel
  defaultBillingProfile BillingProfile @default(NO_FISCAL)
  currentFee        Float              @default(0)
  hasAbono          Boolean            @default(true)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  accountTransactions AccountTransaction[]
  treasuryTransactions TreasuryTransaction[]
  checks              Check[]
}

enum TransactionType {
  CHARGE  // Cargo por abono mensual (Suma a la deuda)
  PAYMENT // Pago de honorarios (Resta a la deuda)
}

model AccountTransaction {
  id          String          @id @default(cuid())
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id])
  date        DateTime        @default(now())
  type        TransactionType
  billingProfile BillingProfile @default(NO_FISCAL)
  netAmount   Float           @default(0)
  ivaAmount   Float           @default(0)
  amount      Float
  description String?
  dueDate     DateTime?
  createdAt   DateTime        @default(now())

  // Relaciones para composición de saldos
  paymentsApplied PaymentApplication[] @relation("ChargeApplications")
  chargesCovered  PaymentApplication[] @relation("PaymentApplications")
}

model PaymentApplication {
  id        String   @id @default(cuid())
  
  chargeId  String
  charge    AccountTransaction @relation("ChargeApplications", fields: [chargeId], references: [id])
  
  paymentId String
  payment   AccountTransaction @relation("PaymentApplications", fields: [paymentId], references: [id])
  
  amount    Float
  createdAt DateTime @default(now())
}

enum TreasuryMovementType {
  INCOME     // Cobros de honorarios
  EXPENSE    // Gastos
  WITHDRAWAL // Retiros de socios / Sueldos
  TRANSFER   // Pases de caja
}

enum CheckStatus {
  IN_PORTFOLIO
  DELIVERED
}

model Check {
  id           String               @id @default(cuid())
  number       String
  bank         String
  issueDate    DateTime             @default(now())
  dueDate      DateTime
  amount       Float
  status       CheckStatus          @default(IN_PORTFOLIO)
  
  clientId     String?
  client       Client?              @relation(fields: [clientId], references: [id])
  
  incomingTxId String?
  incomingTx   TreasuryTransaction? @relation("IncomingChecks", fields: [incomingTxId], references: [id])
  
  outgoingTxId String?
  outgoingTx   TreasuryTransaction? @relation("OutgoingChecks", fields: [outgoingTxId], references: [id])
  
  createdAt    DateTime             @default(now())
}

model TreasuryTransaction {
  id             String               @id @default(cuid())
  date           DateTime             @default(now())
  account        String
  type           TreasuryMovementType
  category       String
  description    String?
  amount         Float
  
  clientId       String?
  client         Client?              @relation(fields: [clientId], references: [id])
  
  incomingChecks Check[]              @relation("IncomingChecks")
  outgoingChecks Check[]              @relation("OutgoingChecks")
  
  createdAt      DateTime             @default(now())
}
